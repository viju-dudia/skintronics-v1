# Copy to .env and fill in locally. Never commit or share the Key Secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret when configuring the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# Product is currently confirmed in stock. Keep false until Razorpay credentials and fulfilment are ready.
CHECKOUT_ENABLED=false
# This integration supports INR. Amounts below are integer paise, not rupees.
CHECKOUT_CURRENCY=INR
PRODUCT_PRICE_PAISE=799900
SHIPPING_PAISE=0
# GST/tax is included in the product price, so there is no additional tax charge.
TAX_PAISE=0
SHIPPING_COUNTRY=IN

APP_ORIGIN=http://127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
# Private durable directory. Keep this outside any other web server's root.
ORDER_DATA_DIR=.data/orders
